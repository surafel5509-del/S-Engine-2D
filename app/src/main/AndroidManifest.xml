<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- S Engine is a 2D engine: GLES2 is the one hard requirement. -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <!-- Optional, used only when a project opts into haptics through scripts. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SEngine">

        <!-- Original S Engine splash → start screen / project manager. -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SEngine.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density"
            android:screenOrientation="fullSensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Start screen: create / import / open projects, examples, documentation, settings. -->
        <activity
            android:name=".ui.ProjectManagerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density" />

        <!-- The editor. Layout adapts to portrait and landscape; handles its own configuration changes. -->
        <activity
            android:name=".ui.EditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density|smallestScreenSize" />

        <!-- Play mode: runs the project scene fullscreen with its own GL surface. -->
        <activity
            android:name=".ui.GameActivity"
            android:exported="false"
            android:theme="@style/Theme.SEngine.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density|smallestScreenSize" />
    </application>
</manifest>
